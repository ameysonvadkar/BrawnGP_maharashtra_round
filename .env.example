# Copy to .env (gitignored) and fill in your own values. Never commit .env.
# Without a key, the agent uses deterministic rule-based fallbacks and runs fully offline.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional: prices for the replay cost estimate (USD per 1M tokens) and exchange rate
# LLM_PRICE_IN_PER_M=0.10
# LLM_PRICE_OUT_PER_M=0.40
# USD_INR=88
